# Copy this file to .env and replace placeholders with your own credentials.
# Never commit .env or place real API keys in Dockerfiles / frontend code.

# REQUIRED: proposal generation uses OpenRouter.
OPENROUTER_API_KEYS=your_openrouter_key_here

# REQUIRED for RAG embeddings / retrieval in backend/rag_engine.py.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# REQUIRED: generate a long random value; do not reuse this placeholder.
ADMIN_SECRET_KEY=replace_with_a_long_random_secret

# Optional Langfuse observability. Keep blank to disable it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional model overrides.
ANALYZER_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
WRITER_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
CRITIC_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# Local recruiter/demo defaults.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8800
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8800
FRONTEND_PORT=3000
LOG_LEVEL=INFO
