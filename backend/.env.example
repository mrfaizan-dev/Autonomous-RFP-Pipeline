

# REQUIRED for RAG embeddings / retrieval in backend/rag_engine.py.
GEMINI_API_KEYS=Enter One Gemini API Key Here
OPENROUTER_API_KEYS=Enter One or Multiple OpenRouter API Keys Here

GROQ_API_KEYS=Enter One GROQ API Key Here


# REQUIRED: generate a long random value; do not reuse this placeholder.
ADMIN_SECRET_KEY=admin                            

# Optional Langfuse observability. Keep blank to disable it.
LANGFUSE_SECRET_KEY=OPTIONAL
LANGFUSE_PUBLIC_KEY=OPTIONAL
LANGFUSE_BASE_URL=https://cloud.langfuse.com
REDIS_URL=redis://localhost:6379/0
# Optional model overrides.
ANALYZER_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
WRITER_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
CRITIC_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
TAVILY_API_KEY=Enter One TAVILY API Key Here

